<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="4dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvTopic"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Topic"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tvEventType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LOW_AVAILABILITY"
            android:textSize="12sp"
            android:textStyle="bold"
            android:padding="4dp"
            android:background="@drawable/badge_event_low"
            android:textColor="@android:color/white"
            app:layout_constraintTop_toBottomOf="@+id/tvTopic"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="30dp" />

        <TextView
            android:id="@+id/tvStatusBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PENDING"
            android:textSize="10sp"
            android:textStyle="bold"
            android:padding="4dp"
            android:background="@drawable/badge_status_pending"
            android:textColor="@android:color/white"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@+id/tvTopic"
            app:layout_constraintStart_toEndOf="@+id/tvEventType"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="30dp" />

        <TextView
            android:id="@+id/tvBlockchainBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔗"
            android:textSize="14sp"
            android:padding="4dp"
            android:background="@drawable/badge_blockchain"
            android:textColor="@android:color/white"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@+id/tvTopic"
            app:layout_constraintStart_toEndOf="@+id/tvStatusBadge"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/tvMessage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Message"
            android:textSize="14sp"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@+id/tvEventType"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tvLocation"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Location"
            android:textSize="12sp"
            android:textColor="#666"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@+id/tvMessage"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/tvTimestamp"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/tvTimestamp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="15.01.2025 10:30"
            android:textSize="12sp"
            android:textColor="#666"
            app:layout_constraintTop_toBottomOf="@+id/tvMessage"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="8dp" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>
